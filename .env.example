# Copy this file to `.env` and fill in real values. `.env` is git-ignored.

# --- Telegram (from BotFather) ---
# BotToken and WebhookSecret must be non-empty for the app to start.
# WebhookUrl is optional: set it to your public HTTPS endpoint in production
# so the bot self-registers its webhook on startup; leave empty for local dev.
TELEGRAM_BOT_TOKEN=changeme
TELEGRAM_WEBHOOK_SECRET=changeme-generate-a-long-random-string
TELEGRAM_WEBHOOK_URL=

# --- PostgreSQL ---
POSTGRES_DB=edutrack
POSTGRES_USER=edutrack
POSTGRES_PASSWORD=edutrack

# --- RabbitMQ (used from later stages) ---
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
