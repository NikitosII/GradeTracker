# Copy this file to `.env` and fill in real values. `.env` is git-ignored.

# --- Telegram (from BotFather) ---
TELEGRAM_BOT_TOKEN=changeme
TELEGRAM_WEBHOOK_SECRET=changeme-generate-a-long-random-string
TELEGRAM_WEBHOOK_URL=

# --- PostgreSQL ---
POSTGRES_DB=edutrack
POSTGRES_USER=edutrack
POSTGRES_PASSWORD=edutrack

# --- RabbitMQ (used from later stages) ---
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest

# --- Bootstrap ---
# If set and absent in the DB, an Admin invite code with this value is seeded
# on startup so the first administrator can /bind. Leave empty to skip.
BOOTSTRAP_ADMIN_CODE=

# --- Observability ---
# Where the apps push OTLP traces + metrics.
#   * Production (docker-compose.prod.yml): leave EMPTY — it defaults to the
#     bundled collector at http://otel-collector:4317, which fans traces out to
#     Jaeger and metrics out to Prometheus. Only override to point at an
#     external collector.
#   * Local dev (no collector in the stack): leave EMPTY to keep OTLP export off;
#     metrics are still scrapable directly at http://localhost:9464/metrics
#     (bot-web) and http://localhost:9465/metrics (bot-worker).
OTLP_ENDPOINT=

# --- Reverse proxy / TLS (Caddy) ---

DOMAIN=bot.example.com
ACME_EMAIL=you@example.com

# --- Grafana ---
GRAFANA_ADMIN_PASSWORD=changeme-strong-password

# --- Postgres backups (postgres-backup-local) ---
# SCHEDULE is a cron expression or a @shortcut (@daily, @hourly, ...).
BACKUP_SCHEDULE=@daily
BACKUP_KEEP_DAYS=7
BACKUP_KEEP_WEEKS=4
BACKUP_KEEP_MONTHS=6
